# Copy this file to `.env` in THIS folder:
#     cp .env.example .env
#
# `.env` is gitignored, so your real key is never committed.
# The server loads it automatically via python-dotenv on startup.

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: a second source. Set this and the agent gains a live web_search tool (Tavily)
# alongside the local guide — the two-source setup from Session 4. Leave it unset and the app
# runs on the guide alone. Free tier at https://tavily.com
# TAVILY_API_KEY=tvly-your-key-here

# Optional: LangSmith tracing draws the whole agent loop for you.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-your-key-here
# LANGSMITH_PROJECT=aie-week2-agentic-search
