# Copy this file to `.env` in this folder and fill in your key:
#     cp .env.example .env
#
# `.env` is gitignored, so your real key is never committed.
# The notebook loads this automatically via python-dotenv (load_dotenv()).

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Optional — LangSmith tracing.
# Uncomment all three lines to see the agent loop drawn step by step at
# https://smith.langchain.com (free to start; key looks like lsv2_...).
# LangChain and LangGraph trace themselves automatically once these are set —
# no @traceable decorators or code changes needed. Heads up: this sends your
# run data to LangSmith's cloud, so leave it commented out if you'd rather not.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-your-key-here
# LANGSMITH_PROJECT=aie-agent-harness
